# Daytona 服务密钥
DAYTONA_ENCRYPTION_KEY=generated-by-env-init
DAYTONA_ENCRYPTION_SALT=generated-by-env-init
DAYTONA_RUNNER_TOKEN=generated-by-env-init
DAYTONA_PROXY_API_KEY=generated-by-env-init
DAYTONA_HEALTH_API_KEY=generated-by-env-init
DAYTONA_SSH_GATEWAY_API_KEY=generated-by-env-init
DAYTONA_OTEL_COLLECTOR_API_KEY=generated-by-env-init

# Daytona SSH Gateway 密钥
DAYTONA_SSH_PRIVATE_KEY=generated-by-env-init
DAYTONA_SSH_PUBLIC_KEY=generated-by-env-init
DAYTONA_SSH_HOST_KEY=generated-by-env-init

# Daytona 服务密码
DAYTONA_POSTGRES_PASSWORD=generated-by-env-init
DAYTONA_REDIS_PASSWORD=generated-by-env-init
DAYTONA_REGISTRY_PASSWORD=generated-by-env-init
DAYTONA_MINIO_PASSWORD=generated-by-env-init
DAYTONA_PGADMIN_PASSWORD=generated-by-env-init

# 从其他机器访问时改为宿主机 IP 或域名
DAYTONA_PUBLIC_HOST=127.0.0.1

# env-init 生成 Dex 登录密码，并在此写入 bcrypt 哈希
DEX_STATIC_PASSWORD_HASH='generated-by-env-init'
