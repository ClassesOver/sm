{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "paths": {
      "@genoffice/pptx-render": [
        "../../reporting/slides_engine/packages/pptx-render/src/index.ts"
      ],
      "@genoffice/pptx-engine/*": [
        "../../reporting/slides_engine/packages/pptx-engine/src/*.ts"
      ],
      "@genoffice/docx-engine": [
        "../../reporting/doc_engine/packages/docx-engine/src/index.ts"
      ],
      "@genoffice/agent-core/*": [
        "../../reporting/slides_engine/packages/agent-core/src/*.ts"
      ],
      "@genoffice/zip-gate": [
        "../../reporting/slides_engine/packages/zip-gate/src/index.ts"
      ],
      "@genoffice/font-metrics": [
        "./src/vendor/genoffice-docs/packages/font-metrics/src/browser.ts"
      ],
      "@genoffice/font-metrics/resolve": [
        "./src/vendor/genoffice-docs/packages/font-metrics/src/resolve.ts"
      ],
      "@genoffice/font-metrics/word-faces.json": [
        "./src/vendor/genoffice-docs/packages/font-metrics/word-faces.json"
      ],
      "@genoffice/i18n": [
        "./src/vendor/genoffice-docs/packages/i18n/src/index.ts"
      ],
      "@genoffice/ui": [
        "./src/vendor/genoffice-docs/packages/ui/src/browser.ts"
      ],
      "@genoffice/pptx-render/preset-geometry": [
        "../../reporting/slides_engine/packages/pptx-render/src/preset-geometry.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
