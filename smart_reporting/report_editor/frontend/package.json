{
  "name": "smart-reporting-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "build": "tsc --noEmit && vite build",
    "check:budget": "node scripts/check-build-budget.mjs",
    "test:budget": "node scripts/check-build-budget.contract.mjs",
    "dev": "vite --host 0.0.0.0",
    "smoke": "node smoke/report-editor-smoke.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@d3fc/d3fc-label-layout": "^7.0.4",
    "@dagrejs/dagre": "^3.1.1",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "3d-force-graph": "^1.80.1",
    "diff": "^8.0.4",
    "diff2html": "^3.4.56",
    "lucide": "^1.46.0",
    "pathfinding": "^0.4.18",
    "plotly.js-dist-min": "^3.3.1",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pathfinding": "^0.1.0",
    "@types/plotly.js": "^3.0.7",
    "@types/three": "^0.186.0",
    "jsdom": "^27.4.0",
    "patch-package": "8.0.1",
    "playwright": "^1.55.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
