          "change": 600,
          "changeRatePercent": 20.0
        },
        "visits": {
          "change": 0,
          "changeRatePercent": 0.0
        }
      },
      "derivation": [
        "current.income = 1200 + 2400 = 3600",
        "current.visits = 10 + 20 = 30",
        "current.incomePerVisit = 3600 / 30 = 120",
        "mom.income = 1000 + 2000 = 3000",
        "mom.incomePerVisit = 3000 / 30 = 100",
        "momComparison.income.changeRate = (3600 - 3000) / |3000| × 100% = 20%"
      ]
