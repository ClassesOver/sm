        "visits": {
          "change": 0,
          "changeRatePercent": 0.0
        }
      },
      "derivation": [
        "current.income = 1200（仅 A）",
        "mom.income = 1000（仅 A）",
        "momComparison.income.changeRate = (1200 - 1000) / |1000| × 100% = 20%"
