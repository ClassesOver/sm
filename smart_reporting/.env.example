AGENT_ENV_FILE=.env
AGENT_MODEL_FAST=qwen3.6-35b-a3b
AGENT_MODEL_STANDARD=deepseek-v4-flash-0731
AGENT_MODEL_STRONG=deepseek-v4-flash-0731
# 每档可独立选择结构化传输；默认使用兼容性更好的 JSON object 协议。
AGENT_MODEL_FAST_STRUCTURED_MODE=json_object
AGENT_MODEL_STANDARD_STRUCTURED_MODE=json_object
AGENT_MODEL_STRONG_STRUCTURED_MODE=json_object
DAYTONA_DEFAULT_SNAPSHOT=sandbox-tools
# 可选：新建 sandbox 仅允许访问的 IPv4 CIDR，最多 10 项；为空时封锁全部出网。
DAYTONA_NETWORK_ALLOW_LIST=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
AGENT_OS_HOST=127.0.0.1
AGENT_OS_PORT=7777
AGENT_OS_WORKERS=1
AGENT_OS_RELOAD=true
AGENT_OS_ACCESS_LOG=false
# DSH 访问 /mcp 时实际发送的 Host，生产环境必须显式配置；多个值用逗号分隔。
AGENT_REPORTING_MCP_ALLOWED_HOSTS=127.0.0.1:7777,localhost:7777
AGENT_DEBUG=false
AGNO_TELEMETRY=false
# 经 vLLM 提供 DeepSeek V4 时启用官方 chat_template_kwargs reasoning 格式。
AGENT_MODEL_VLLM_REASONING=false
# 启用后完整采集 Prompt、模型输出、工具参数和工具结果，并写入 AgentOS 数据库。
AGENT_TRACING_ENABLED=false
AGENT_ENABLE_TOOL_RESULT_COMPRESSION=true
AGENT_ENABLE_SESSION_SUMMARIES=true
AGENT_REPORT_CODING_ENABLE_THINKING=true
AGENT_REPORT_CODING_TEMPERATURE=0.1
AGENT_REPORT_CODING_REASONING_EFFORT=high
AGENT_REPORT_CODING_THINKING_BUDGET=8192
AGENT_REPORT_ENABLE_THINKING=true
AGENT_REPORT_PLANNER_REASONING_EFFORT=high
AGENT_REPORT_PLANNER_THINKING_BUDGET=8192
AGENT_REPORT_ENABLE_VISION=false
AGENT_REPORT_VISION_MODEL=qwen3.6-flash
AGENT_MODEL_TIMEOUT_SECONDS=900
AGENT_CONTEXT_TOKEN_BUDGET=262144
AGENT_OUTPUT_TOKEN_RESERVE=32768
AGENT_REPORT_SECTION_CONCURRENCY=1
AGENT_REPORT_ANALYSIS_CONCURRENCY=1
AGENT_REPORT_CODING_EXECUTION_MODE=sequential
# 可选：Reporting Worker 额外加载的 Agno Skills 根目录。
AGENT_SKILLS_DIR=
# 可选：只读 PostgreSQL 数据源配置文件；DSN 只从配置声明的环境变量读取。
AGENT_REPORT_DATA_SOURCES_DIR=
AGENT_REPORT_METADATA_URL=
AGENT_REPORT_METADATA_TOKEN=
# AgentOS 对外可访问的基址，用于生成完整报告下载链接（不含末尾斜杠）。
AGENT_REPORT_PUBLIC_BASE_URL=http://127.0.0.1:33046
REPORT_STARROCKS_DSN=
AGENTOS_CORS_ORIGINS=http://127.0.0.1:18069,http://localhost:18069
