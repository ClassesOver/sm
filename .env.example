# OpenAI 兼容 API，只需手工填写此密钥
OPENAI_API_KEY=sk-your-api-key

# 容器部署参数；agentos_dev/.env.example 是宿主机本地运行模板
AGENT_OS_WORKERS=1
AGENT_OS_ACCESS_LOG=true
JWT_VERIFICATION_KEY=replace-with-jwt-verification-key
JWT_ALGORITHM=HS256
# JWT_AUDIENCE=report-agent-os
AGENT_DEBUG=false
AGENT_TRACING_ENABLED=false
# 可选：配置后同时写入 Agno PostgreSQL 和 Phoenix；Cloud 部署还需 API Key。
AGENT_TRACING_PHOENIX_ENDPOINT=
AGENT_TRACING_PHOENIX_API_KEY=
AGENT_TRACING_PHOENIX_PROJECT=agentos
AGENT_ENABLE_TOOL_RESULT_COMPRESSION=true
AGENT_ENABLE_SESSION_SUMMARIES=true
AGENT_ASSISTANT_ENABLE_THINKING=false
AGENT_CODING_ENABLE_THINKING=true
AGENT_CODING_REASONING_EFFORT=medium
AGENT_CODING_THINKING_BUDGET=16384
AGENT_REPORT_CODING_ENABLE_THINKING=true
AGENT_REPORT_CODING_REASONING_EFFORT=medium
AGENT_REPORT_CODING_THINKING_BUDGET=16384
AGENT_REPORT_ENABLE_THINKING=true
AGENT_REPORT_ENABLE_VISION=false
AGENT_MODEL_TIMEOUT_SECONDS=900
AGENT_CONTEXT_TOKEN_BUDGET=262144
AGENT_HISTORY_TOKEN_BUDGET=196608
# 可选：宿主机上的报表数据源配置目录；Compose 会将其只读挂载到 AgentOS 容器。
# 配置中的 dsnEnv 只引用环境变量名，绝不写入明文 DSN。
AGENT_REPORT_DATA_SOURCES_DIR=
AGENT_REPORT_METADATA_URL=
AGENT_REPORT_METADATA_TOKEN=
REPORT_STARROCKS_DSN=
AGENT_OUTPUT_TOKEN_RESERVE=32768

# AgentOS PostgreSQL
AGENT_POSTGRES_PASSWORD=generated-by-env-init

# 数据卷前缀；旧统一部署复用原卷时改为 agui-daytona_
AGENTOS_VOLUME_PREFIX=agentos_

# Odoo/AgentOS 工作区能力密钥，必须与 Odoo 系统参数
# agui_chat.workspace_hmac_secret 一致
AGUI_WORKSPACE_HMAC_SECRET=generated-by-env-init

# 宿主 Python 与 AgentOS 容器分别使用的 Daytona API 地址
DAYTONA_API_URL=http://127.0.0.1:33043/api
AGENT_DAYTONA_API_URL=http://host.docker.internal:33043/api

# Daytona SDK Key，仅在 Daytona Dashboard 首次引导后写入
DAYTONA_API_KEY=
