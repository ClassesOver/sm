# OpenAI-compatible API
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen3.6-35b-a3b

# AgentOS server
AGENT_OS_HOST=0.0.0.0
AGENT_OS_PORT=7777
AGENT_OS_WORKERS=4
AGENT_OS_RELOAD=false
AGENT_OS_ACCESS_LOG=false

# AgentOS PostgreSQL
AGENT_POSTGRES_DB=dev
AGENT_POSTGRES_USER=odoo
AGENT_POSTGRES_PASSWORD=replace-with-strong-agent-postgres-password

# Allowed browser origins
AGENTOS_CORS_ORIGINS=http://127.0.0.1:18069,http://localhost:18069

# Odoo/AgentOS workspace capability (same value as the Odoo system parameter
# agui_chat.workspace_hmac_secret; generate with: openssl rand -hex 32)
AGUI_WORKSPACE_HMAC_SECRET=replace-with-64-hex-characters

# Administrator-managed Agno skills, mounted read-only in AgentOS
AGENT_SKILLS_DIR=./deploy/daytona/skills
AGENT_SKILLS_TRUSTED_UID=1000

# Pre-created external Docker network shared by AgentOS and Daytona services
AGUI_SHARED_NETWORK=hrp_network

# Daytona SDK authentication. Leave empty only for the first Daytona bootstrap,
# then create a key in Dashboard and restart AgentOS with the key populated.
DAYTONA_API_KEY=

# Daytona service secrets (generate a different random value for every entry)
DAYTONA_ENCRYPTION_KEY=replace-with-random-encryption-key
DAYTONA_ENCRYPTION_SALT=replace-with-random-encryption-salt
DAYTONA_RUNNER_TOKEN=replace-with-random-runner-token
DAYTONA_PROXY_API_KEY=replace-with-random-proxy-key
DAYTONA_HEALTH_API_KEY=replace-with-random-health-key

# Daytona PostgreSQL, Redis, Registry, and MinIO
DAYTONA_POSTGRES_USER=daytona
DAYTONA_POSTGRES_PASSWORD=replace-with-strong-postgres-password
DAYTONA_POSTGRES_DB=daytona
DAYTONA_REDIS_PASSWORD=replace-with-strong-redis-password
DAYTONA_REGISTRY_USER=daytona
DAYTONA_REGISTRY_PASSWORD=replace-with-strong-registry-password
DAYTONA_MINIO_USER=daytona
DAYTONA_MINIO_PASSWORD=replace-with-strong-minio-password

# Daytona local Dashboard, Dex, and sandbox preview Proxy
DAYTONA_DASHBOARD_PORT=13000
DAYTONA_DASHBOARD_URL=http://127.0.0.1:13000/dashboard
DAYTONA_DASHBOARD_BASE_API_URL=http://127.0.0.1:13000
DAYTONA_PUBLIC_OIDC_DOMAIN=http://127.0.0.1:13000/dex
DAYTONA_PROXY_PORT=14000
DAYTONA_PROXY_DOMAIN=proxy.localhost:14000
DEX_ADMIN_EMAIL=admin@example.com
# Generate with: htpasswd -BinC 10 admin | cut -d: -f2
DEX_STATIC_PASSWORD_HASH='replace-with-bcrypt-hash'

# Default sandbox and organization quotas
DAYTONA_RUNNER_CPU=4
DAYTONA_RUNNER_MEMORY=8
DAYTONA_RUNNER_DISK=50
DAYTONA_TOTAL_CPU_QUOTA=64
DAYTONA_TOTAL_MEMORY_QUOTA=128
DAYTONA_TOTAL_DISK_QUOTA=1000
DAYTONA_MAX_CPU_PER_SANDBOX=8
DAYTONA_MAX_MEMORY_PER_SANDBOX=16
DAYTONA_MAX_DISK_PER_SANDBOX=100
