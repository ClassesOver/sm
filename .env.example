# Compose 和国内容器镜像源默认配置
COMPOSE_PROJECT_NAME=agui-daytona
DOCKER_REGISTRY_MIRROR=docker.m.daocloud.io
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
DAYTONA_IMAGE_REGISTRY=docker.io
DAYTONA_IMAGE_ARCH=amd64
DAYTONA_DEFAULT_SNAPSHOT=docker.io/daytonaio/sandbox:0.5.0-slim
DEX_IMAGE=docker.io/dexidp/dex:v2.42.0
APT_MIRROR_HOST=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# OpenAI 兼容 API（运行 env-init 后填写 API Key）
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen3.6-35b-a3b

# AgentOS 服务
AGENT_OS_BIND=127.0.0.1
AGENT_OS_HOST=0.0.0.0
AGENT_OS_PORT=7777
AGENT_OS_WORKERS=4
AGENT_OS_RELOAD=false
AGENT_OS_ACCESS_LOG=false

# AgentOS PostgreSQL 数据库
AGENT_POSTGRES_BIND=127.0.0.1
AGENT_POSTGRES_HOST=127.0.0.1
AGENT_POSTGRES_PORT=55432
AGENT_POSTGRES_DB=dev
AGENT_POSTGRES_USER=odoo
AGENT_POSTGRES_PASSWORD=generated-by-env-init

# 允许访问的浏览器来源
AGENTOS_CORS_ORIGINS=http://127.0.0.1:18069,http://localhost:18069

# Odoo/AgentOS 工作区能力密钥，必须与 Odoo 系统参数
# agui_chat.workspace_hmac_secret 一致；env-init 生成 43 位 Base64URL 值
AGUI_WORKSPACE_HMAC_SECRET=generated-by-env-init

# 管理员维护的 Agno 技能目录，在 AgentOS 中以只读方式挂载
AGENT_SKILLS_DIR=./deploy/daytona/skills
AGENT_SKILLS_TRUSTED_UID=1000

# AgentOS 和 Daytona 服务共享的预创建 Docker 外部网络
AGUI_SHARED_NETWORK=hrp_network

# Daytona SDK 认证。仅在 Daytona 首次引导时留空；随后在 Dashboard 创建 Key，
# 写入该值并重启 AgentOS。
DAYTONA_API_KEY=

# Daytona 服务密钥，每项由 env-init 独立生成随机值
DAYTONA_ENCRYPTION_KEY=generated-by-env-init
DAYTONA_ENCRYPTION_SALT=generated-by-env-init
DAYTONA_RUNNER_TOKEN=generated-by-env-init
DAYTONA_PROXY_API_KEY=generated-by-env-init
DAYTONA_HEALTH_API_KEY=generated-by-env-init

# Daytona PostgreSQL、Redis、Registry 和 MinIO
DAYTONA_POSTGRES_USER=daytona
DAYTONA_POSTGRES_PASSWORD=generated-by-env-init
DAYTONA_POSTGRES_DB=daytona
DAYTONA_REDIS_PASSWORD=generated-by-env-init
DAYTONA_REGISTRY_USER=daytona
DAYTONA_REGISTRY_PASSWORD=generated-by-env-init
DAYTONA_MINIO_USER=daytona
DAYTONA_MINIO_PASSWORD=generated-by-env-init

# Daytona 对外访问地址；端口和 BIND 使用 Compose 默认值
DAYTONA_PUBLIC_HOST=127.0.0.1
DEX_ADMIN_EMAIL=admin@example.com
# env-init 生成 12 位登录密码，并在此写入 bcrypt 哈希
DEX_STATIC_PASSWORD_HASH='generated-by-env-init'

# 默认沙箱和组织配额
DAYTONA_RUNNER_CPU=4
DAYTONA_RUNNER_MEMORY=8
DAYTONA_RUNNER_DISK=50
DAYTONA_TOTAL_CPU_QUOTA=64
DAYTONA_TOTAL_MEMORY_QUOTA=128
DAYTONA_TOTAL_DISK_QUOTA=1000
DAYTONA_MAX_CPU_PER_SANDBOX=8
DAYTONA_MAX_MEMORY_PER_SANDBOX=16
DAYTONA_MAX_DISK_PER_SANDBOX=100
