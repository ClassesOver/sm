# OpenAI 兼容 API，只需手工填写此密钥
OPENAI_API_KEY=sk-your-api-key

# 容器部署参数；smart_reporting/.env.example 是宿主机本地运行模板
AGENTOS_REPORTING_IMAGE=agentos-reporting-reporting-os:latest

# 构建参数；离线/内网部署时替换为内部镜像源和私有 registry
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
UV_IMAGE=ghcr.m.daocloud.io/astral-sh/uv:0.11.26
NODE_IMAGE=docker.m.daocloud.io/library/node:22-slim
APT_MIRROR_HOST=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com
UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/

# 报表完成时返回给调用方的 markdown 模板；未设置时使用默认紧凑格式。
# 可用变量：{report_title}、{editor_url}、{pdf_url}、{word_url}、{actions}
# AGENT_REPORT_COMPLETION_TEMPLATE=
# 报告交付外观由部署配置独立管理；编制单位留空使用默认名称。
AGENT_REPORT_ORGANIZATION_NAME=上海鼎医信息技术有限公司
AGENT_REPORT_GENERATED_BY_LABEL=AI 智能报告平台生成
AGENT_REPORT_WATERMARK_TEXT=AI 智能报告平台生成
AGENT_REPORT_HEADER_LEFT={organization}
AGENT_REPORT_HEADER_RIGHT={title}
AGENT_REPORT_FOOTER_LEFT=企业智能运营报表
AGENT_REPORT_FOOTER_RIGHT=第 {page} / {pages} 页
# 新报告构建身份：由交付构建生成并四项一起配置，不填示例/占位哈希。
# AGENT_REPORT_BUILD_COMMIT=
# AGENT_REPORT_SOURCE_HASH=
# AGENT_REPORT_DEPENDENCY_HASH=
# AGENT_REPORT_COMPILER_VERSION=
AGENT_OS_WORKERS=1
AGENT_OS_ACCESS_LOG=true
# 可选：服务日志文件。Compose 默认覆盖为容器内的持久化路径。
AGENT_LOG_FILE=
AGENT_LOG_FILE_MAX_BYTES=52428800
AGENT_LOG_FILE_BACKUP_COUNT=5
AGENT_DEBUG=false
AGNO_TELEMETRY=false
AGENT_TRACING_ENABLED=false
# 经 vLLM 提供模型时启用标准 reasoning；硬 Token 预算由下一项独立控制。
AGENT_MODEL_VLLM_REASONING=false
# vLLM 已配置 --reasoning-config 时才开启硬 Token 预算；默认关闭。
AGENT_MODEL_VLLM_THINKING_BUDGET=false
# OpenAI-compatible Chat 地址为 LiteLLM Proxy 时启用原生参数 allowlist 与扩展参数透传。
AGENT_MODEL_LITELLM_PROXY=false
AGENT_ENABLE_TOOL_RESULT_COMPRESSION=true
AGENT_ENABLE_SESSION_SUMMARIES=true
AGENT_REPORT_CODING_ENABLE_THINKING=true
AGENT_REPORT_CODING_TEMPERATURE=0.1
AGENT_REPORT_CODING_REASONING_EFFORT=low
AGENT_REPORT_CODING_THINKING_BUDGET=8192
AGENT_REPORT_ENABLE_THINKING=true
# Planner 支持 low/high/max；默认 high。配置 low 不会开启原本关闭思考的阶段，失败恢复仍按阶段策略升级。
AGENT_REPORT_PLANNER_REASONING_EFFORT=high
# 同时作为章节思考预算上限；整章正文按 2048 × block 数计算，再受此值约束。
AGENT_REPORT_PLANNER_THINKING_BUDGET=8192
AGENT_REPORT_ENABLE_VISION=false
AGENT_REPORT_VISION_MODEL=qwen3.6-flash
AGENT_MODEL_TIMEOUT_SECONDS=900
# 报告默认总预算为 512K；输出预留留空时固定取总预算的 1/8（默认 64K），输入为 7/8。
# 实际请求仍受已验证的模型窗口约束；显式设置输出预留可覆盖默认比例。
AGENT_REPORT_CONTEXT_TOKEN_BUDGET=524288
AGENT_REPORT_OUTPUT_TOKEN_RESERVE=
# 章节默认逐章执行，保留前序正文复核及补证顺序。
AGENT_REPORT_SECTION_CONCURRENCY=1
# 每章最多生成的图表数（进程启动时读取，默认 3；非法值软告警并回退默认）。
AGENT_REPORT_MAX_SECTION_CHART_COUNT=3
# 默认一次生成整章正文；设为 false 使用原有逐块生成流程。
AGENT_REPORT_SECTION_WHOLE_GENERATION=true
# 标准补证默认启用；显式设为 false 时整组回退 Python 补证。
AGENT_REPORT_STANDARD_SUPPLEMENTAL_ENABLED=true
# 编辑器 AI 改图、改表默认启用；各自设为 false 可关闭对应入口。
AGENT_REPORT_EDITOR_CHART_AI_ENABLED=true
AGENT_REPORT_EDITOR_TABLE_AI_ENABLED=true
# 原生编辑独立灰度；浏览器与部署验收后按能力开启。
AGENT_NATIVE_DOCX_ENABLED=false
AGENT_NATIVE_PDF_ENABLED=false
AGENT_NATIVE_AI_ENABLED=false
AGENT_NATIVE_PDF_TEXT_ENABLED=false
AGENT_NATIVE_UPLOAD_ENABLED=false
# Office 复杂场景编码任务（CodexAgent）；须在部署镜像实测沙箱写入边界后再开启。
# 接口须支持 OpenAI Responses 协议；留空沿用 OPENAI_BASE_URL 与标准模型。
AGENT_OFFICE_CODEX_ENABLED=false
AGENT_OFFICE_CODEX_BASE_URL=
AGENT_OFFICE_CODEX_MODEL=
AGENT_OFFICE_CODEX_TIMEOUT_SECONDS=600
# 补证与章节分析项的并发上限（1–5，默认5），仅在 AGENT_REPORT_CODING_EXECUTION_MODE=parallel 时生效。
# 模型服务限流或宿主资源不足时可显式调低；不承诺耗时按并发数等比例下降。
AGENT_REPORT_ANALYSIS_CONCURRENCY=5
# 默认并行分析；章节并发仍为 1。显式设 sequential 可恢复串行分析。
AGENT_REPORT_CODING_EXECUTION_MODE=parallel
# 数据追溯独立灰度开关；关闭展示不会删除已冻结的历史证据。
AGENT_REPORT_LINEAGE_REGISTRATION_ENABLED=true
AGENT_REPORT_LINEAGE_PANEL_ENABLED=true
AGENT_REPORT_LINEAGE_DOWNLOAD_ENABLED=true
AGENT_REPORT_LINEAGE_DRILLDOWN_ENABLED=true
AGENT_REPORT_LINEAGE_EXPORT_SOURCES_ENABLED=true
# 新报告只读取管理数据库中的已发布连接、目录、指标和统计口径。
AGENT_REPORT_CONFIGURATION_MODE=database
# 可选：供管理员显式导入连接文件的目录；报告启动不读取旧业务 Profile。
# 导入文件的 dsnEnv 只引用环境变量名，绝不写入明文 DSN。
AGENT_REPORT_DATA_SOURCES_DIR=
# 宿主机上的 tiktoken 缓存目录；外网启动时自动下载，内网部署必须提前预置。
AGENT_TIKTOKEN_CACHE_DIR=
# 可选：宿主机上的报表工作区目录；报告修订的 Markdown/图片保存在此，必须持久化。
AGENT_REPORT_WORKSPACE_DIR=
AGENT_REPORT_METADATA_URL=
AGENT_REPORT_METADATA_TOKEN=
# AgentOS 对外可访问的基址，用于生成完整报告下载链接（不含末尾斜杠）。
AGENT_REPORT_PUBLIC_BASE_URL=http://127.0.0.1:33046
REPORT_STARROCKS_DSN=

# 使用中台 SDK 模型时设置以下两项；AGENT_MODEL_FAST/STANDARD/STRONG 填中台 profile key。
# 留空则保留 OPENAI_BASE_URL / OPENAI_API_KEY 的直连模式。
DINGYI_PLATFORM_URL=
DINGYI_PLATFORM_SERVICE_TOKEN=
AGENT_OUTPUT_TOKEN_RESERVE=32768

# AgentOS PostgreSQL
AGENT_POSTGRES_PASSWORD=generated-by-env-init

# AgentOS 工作区能力签名密钥
AGENT_WORKSPACE_HMAC_SECRET=generated-by-env-init

# 原生编辑正式开关（优先于兼容的 AGENT_NATIVE_* 别名）
AGENT_REPORT_EDITOR_DOCX_ENABLED=false
AGENT_REPORT_EDITOR_PDF_ENABLED=false
AGENT_REPORT_EDITOR_AI_ENABLED=false
AGENT_REPORT_EDITOR_PDF_TEXT_ENABLED=false
AGENT_REPORT_EDITOR_UPLOAD_ENABLED=false
# 管理后台：本机开发启用 HTTP；生产环境使用 HTTPS Origin，保持 LOCAL_HTTP=false。
# 管理 bundle 默认取编辑器静态目录下 management/，可通过 STATIC_DIR 单独覆盖。
AGENT_MANAGEMENT_PUBLIC_ORIGIN=
AGENT_MANAGEMENT_LOCAL_HTTP=false
AGENT_MANAGEMENT_STATIC_DIR=
# 数据源凭据加密密钥，格式 key-id:Fernet-key；须安全保存并与数据库一起备份。
AGENT_MANAGEMENT_CREDENTIAL_KEYS=
