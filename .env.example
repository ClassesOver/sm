# OpenAI 兼容 API，只需手工填写此密钥
OPENAI_API_KEY=sk-your-api-key

# 容器部署参数；agentos_dev/.env.example 是宿主机本地运行模板
AGENT_OS_WORKERS=4
AGENT_OS_ACCESS_LOG=true
AGENT_DEBUG=false
AGENT_ENABLE_TOOL_RESULT_COMPRESSION=true
AGENT_ENABLE_SESSION_SUMMARIES=true
AGENT_ENABLE_THINKING=true
AGENT_CONTEXT_TOKEN_BUDGET=262144
AGENT_HISTORY_TOKEN_BUDGET=196608
# 可选：宿主机上的只读 PostgreSQL 数据源配置；Compose 会将其挂载到 AgentOS 容器。
# 配置中的 dsnEnv 只引用环境变量名，绝不写入明文 DSN。
AGENT_REPORT_DATA_SOURCES_FILE=
AGENT_OUTPUT_TOKEN_RESERVE=32768

# AgentOS PostgreSQL
AGENT_POSTGRES_PASSWORD=generated-by-env-init

# 数据卷前缀；旧统一部署复用原卷时改为 agui-daytona_
AGENTOS_VOLUME_PREFIX=agentos_

# Odoo/AgentOS 工作区能力密钥，必须与 Odoo 系统参数
# agui_chat.workspace_hmac_secret 一致
AGUI_WORKSPACE_HMAC_SECRET=generated-by-env-init

# 宿主 Python 与 AgentOS 容器分别使用的 Daytona API 地址
DAYTONA_API_URL=http://127.0.0.1:33043/api
AGENT_DAYTONA_API_URL=http://host.docker.internal:33043/api

# Daytona SDK Key，仅在 Daytona Dashboard 首次引导后写入
DAYTONA_API_KEY=
