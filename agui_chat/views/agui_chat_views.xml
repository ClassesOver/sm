<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agui_chat_config_tree" model="ir.ui.view">
        <field name="name">agui.chat.config.tree</field>
        <field name="model">agui.chat.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="chat_enabled"/>
                <field name="host_tools_enabled"/>
                <field name="write_tools_enabled"/>
                <field name="runtime_url"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_agui_chat_config_form" model="ir.ui.view">
        <field name="name">agui.chat.config.form</field>
        <field name="model">agui.chat.config</field>
        <field name="arch" type="xml">
            <form string="智能助手配置">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="例如：默认配置"/></h1>
                    </div>
                    <group>
                        <group string="配置状态">
                            <field name="active"/>
                            <field name="chat_enabled"/>
                        </group>
                        <group string="工具能力">
                            <field name="host_tools_enabled"/>
                            <field name="write_tools_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="运行服务">
                            <group>
                                <group string="服务连接">
                                    <field name="runtime_url" placeholder="例如：/contract-review/agui"/>
                                    <field name="agentos_internal_url" placeholder="例如：http://agent:7777"/>
                                    <field name="default_agent_id" placeholder="例如：odoo-assistant"/>
                                </group>
                                <group string="开发选项">
                                    <field name="allow_cross_origin_dev"/>
                                </group>
                            </group>
                        </page>
                        <page string="工具权限">
                            <group string="命令白名单">
                                <field name="enabled_command_ids" widget="many2many_tags"
                                       domain="[('command_type', '=', 'page'), ('active', '=', True)]"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="enabled_business_command_ids" widget="many2many_tags"
                                       domain="[('command_type', '=', 'business'), ('active', '=', True)]"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                        </page>
                        <page string="兼容存储">
                            <group>
                                <field name="enabled_commands" readonly="1"/>
                                <field name="enabled_business_commands" readonly="1"/>
                            </group>
                        </page>
                        <page string="安全与容量">
                            <group string="数据安全">
                                    <field name="sensitive_field_names" placeholder="以逗号分隔 HRP 字段名"/>
                            </group>
                            <group>
                                <group string="请求限制">
                                    <field name="max_request_bytes"/>
                                    <field name="max_messages"/>
                                    <field name="max_sse_event_bytes"/>
                                </group>
                                <group string="数据保留">
                                    <field name="session_retention_days"/>
                                    <field name="audit_retention_days"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agui_chat_config" model="ir.actions.act_window">
        <field name="name">智能助手配置</field>
        <field name="res_model">agui.chat.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_agui_chat_command_tree" model="ir.ui.view">
        <field name="name">agui.chat.command.tree</field>
        <field name="model">agui.chat.command</field>
        <field name="arch" type="xml">
            <tree string="命令主数据" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="code"/>
                <field name="command_type"/>
            </tree>
        </field>
    </record>

    <record id="view_agui_chat_command_form" model="ir.ui.view">
        <field name="name">agui.chat.command.form</field>
        <field name="model">agui.chat.command</field>
        <field name="arch" type="xml">
            <form string="命令主数据">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="command_type"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agui_chat_command" model="ir.actions.act_window">
        <field name="name">命令主数据</field>
        <field name="res_model">agui.chat.command</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_agui_chat_session_tree" model="ir.ui.view">
        <field name="name">agui.chat.session.tree</field>
        <field name="model">agui.chat.session</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="name"/>
                <field name="thread_id"/>
                <field name="parent_session_id"/>
                <field name="protocol"/>
                <field name="surface"/>
                <field name="session_revision"/>
                <field name="write_date" string="最后更新时间"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_agui_chat_session_form" model="ir.ui.view">
        <field name="name">agui.chat.session.form</field>
        <field name="model">agui.chat.session</field>
        <field name="arch" type="xml">
            <form string="AG-UI 对话会话" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="thread_id"/>
                        <field name="parent_session_id"/>
                        <field name="protocol"/>
                        <field name="agent_id"/>
                        <field name="surface"/>
                        <field name="session_revision"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="消息"><field name="messages_json" nolabel="1"/></page>
                        <page string="智能体状态"><field name="agent_state_json" nolabel="1"/></page>
                        <page string="界面偏好"><field name="ui_preferences_json" nolabel="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agui_chat_session" model="ir.actions.act_window">
        <field name="name">AG-UI 对话会话</field>
        <field name="res_model">agui.chat.session</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('active', '=', True), ('protocol', '=', 'agui.odoo.v2')]</field>
    </record>

    <record id="view_agui_chat_tool_policy_tree" model="ir.ui.view">
        <field name="name">agui.chat.tool.policy.tree</field>
        <field name="model">agui.chat.tool.policy</field>
        <field name="arch" type="xml">
            <tree string="工具策略"
                  decoration-muted="not active"
                  decoration-danger="active and access_level == 'write' and confirmation_mode == 'never'">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="tool_name"/>
                <field name="access_level"/>
                <field name="model_name"/>
                <field name="confirmation_mode"/>
                <field name="group_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_agui_chat_tool_policy_form" model="ir.ui.view">
        <field name="name">agui.chat.tool.policy.form</field>
        <field name="model">agui.chat.tool.policy</field>
        <field name="arch" type="xml">
            <form string="AG-UI 工具策略">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="例如：客户资料只读"/></h1>
                    </div>
                    <group>
                        <group string="匹配范围">
                            <field name="tool_name" placeholder="例如：odoo.open_record"/>
                            <field name="model_name" placeholder="留空表示所有模型"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                        <group string="执行控制">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="access_level"/>
                            <field name="confirmation_mode"/>
                        </group>
                    </group>
                    <group string="字段范围">
                        <field name="field_names" widget="text" class="o_agui_wrap_field" placeholder="留空表示所有字段；多个字段以逗号分隔"/>
                        <field name="high_risk_field_names" widget="text" class="o_agui_wrap_field" placeholder="多个字段以逗号分隔"/>
                        <field name="button_names" widget="text" class="o_agui_wrap_field" placeholder="原生按钮 name；多个名称以逗号分隔"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_agui_chat_tool_policy" model="ir.actions.act_window">
        <field name="name">工具策略</field>
        <field name="res_model">agui.chat.tool.policy</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_agui_chat_root" name="智能助手" sequence="90"/>
    <menuitem id="menu_agui_chat_sessions" name="对话会话" parent="menu_agui_chat_root" action="action_agui_chat_session" sequence="20"/>
    <menuitem id="menu_agui_chat_config" name="配置" parent="menu_agui_chat_root" action="action_agui_chat_config" groups="base.group_system" sequence="30"/>
    <menuitem id="menu_agui_chat_command" name="命令主数据" parent="menu_agui_chat_root" action="action_agui_chat_command" groups="base.group_system" sequence="35"/>
    <menuitem id="menu_agui_chat_tool_policy" name="工具策略" parent="menu_agui_chat_root" action="action_agui_chat_tool_policy" groups="base.group_system" sequence="40"/>
</odoo>
