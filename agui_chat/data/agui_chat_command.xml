<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="command_navigate_menu" model="agui.chat.command">
        <field name="name">导航菜单</field>
        <field name="code">odoo.navigate_menu</field>
        <field name="command_type">page</field>
        <field name="description">按名称导航当前可见且自身配置 action 的末级菜单；唯一匹配直接打开，多候选返回选择项，也可打开上下文已明确选择的菜单 ID。</field>
        <field name="sequence">9</field>
    </record>
    <record id="command_apply_filter" model="agui.chat.command">
        <field name="name">应用筛选</field>
        <field name="code">odoo.apply_filter</field>
        <field name="command_type">page</field>
        <field name="description">仅当当前宿主快照的 viewType 为 list 或 kanban 时，在对应搜索视图中添加一个可见原生筛选并返回匹配记录候选；Odoo tree 视图按 list 兼容，其他视图类型不可用。</field>
        <field name="sequence">20</field>
    </record>
    <record id="command_apply_group" model="agui.chat.command">
        <field name="name">设置当前视图分组</field>
        <field name="code">odoo.apply_group</field>
        <field name="command_type">page</field>
        <field name="description">仅当当前宿主快照的 viewType 为 list 或 kanban 时，设置对应搜索视图的完整原生分组状态；Odoo tree 视图按 list 兼容，其他视图类型不可用，空数组表示清除分组。</field>
        <field name="sequence">21</field>
    </record>
    <record id="command_open_record" model="agui.chat.command">
        <field name="name">打开记录</field>
        <field name="code">odoo.open_record</field>
        <field name="command_type">page</field>
        <field name="description">使用当前快照提供的记录 token 打开记录，可进入只读或编辑态。</field>
        <field name="sequence">30</field>
    </record>
    <record id="command_open_create" model="agui.chat.command">
        <field name="name">新建记录</field>
        <field name="code">odoo.open_create</field>
        <field name="command_type">page</field>
        <field name="description">使用当前 action 上下文进入原生完整新建表单；不填写也不保存。</field>
        <field name="sequence">40</field>
    </record>
    <record id="command_switch_view" model="agui.chat.command">
        <field name="name">切换视图</field>
        <field name="code">odoo.switch_view</field>
        <field name="command_type">page</field>
        <field name="description">仅当当前宿主快照的 viewType 为 list 或 kanban 时调用，在当前 action 声明的 Kanban、List 和 Form 原生视图之间切换；Odoo tree 视图按 list 兼容，Form 当前视图不可调用。</field>
        <field name="sequence">41</field>
    </record>
    <record id="command_open_x2many_record" model="agui.chat.command">
        <field name="name">打开明细表单</field>
        <field name="code">odoo.open_x2many_record</field>
        <field name="command_type">page</field>
        <field name="description">使用当前快照的明细行令牌打开原生 One2many 表单。</field>
        <field name="sequence">42</field>
    </record>
    <record id="command_open_x2many_create" model="agui.chat.command">
        <field name="name">新建明细表单</field>
        <field name="code">odoo.open_x2many_create</field>
        <field name="command_type">page</field>
        <field name="description">使用当前快照的明细字段令牌打开原生 One2many 新建表单。</field>
        <field name="sequence">42</field>
    </record>
    <record id="command_reload_current_form" model="agui.chat.command">
        <field name="name">重新载入当前表单</field>
        <field name="code">odoo.reload_current_form</field>
        <field name="command_type">page</field>
        <field name="description">在没有未保存更改时重新载入当前原生表单。</field>
        <field name="sequence">45</field>
    </record>
    <record id="command_enter_edit_mode" model="agui.chat.command">
        <field name="name">进入编辑模式</field>
        <field name="code">odoo.enter_edit_mode</field>
        <field name="command_type">page</field>
        <field name="description">让当前原生表单进入编辑模式；不修改字段，也不保存。</field>
        <field name="sequence">50</field>
    </record>
    <record id="command_activate_view_control" model="agui.chat.command">
        <field name="name">激活视图控件</field>
        <field name="code">odoo.activate_view_control</field>
        <field name="command_type">page</field>
        <field name="description">激活当前看板快照中的可见控件 token；对象按钮始终需要用户确认。</field>
        <field name="sequence">60</field>
    </record>
    <record id="command_search_relation" model="agui.chat.command">
        <field name="name">搜索关系字段</field>
        <field name="code">odoo.search_relation</field>
        <field name="command_type">page</field>
        <field name="description">仅当当前宿主快照的 viewType 为 form 时，使用当前表单的域和上下文搜索可写关系字段；其他视图类型不可用。</field>
        <field name="sequence">70</field>
    </record>
    <record id="command_stage_current_form" model="agui.chat.command">
        <field name="name">暂存当前表单</field>
        <field name="code">odoo.stage_current_form</field>
        <field name="command_type">page</field>
        <field name="description">仅当当前宿主快照的 viewType 为 form 时，调用原生 onchange 暂存当前表单或可见 One2many 行字段，不保存；其他视图类型不可用。</field>
        <field name="sequence">75</field>
    </record>
    <record id="command_patch_current_form" model="agui.chat.command">
        <field name="name">修改当前表单</field>
        <field name="code">odoo.patch_current_form</field>
        <field name="command_type">page</field>
        <field name="description">仅当当前宿主快照的 viewType 为 form 时，应用并保存当前表单变更；只读模式会自动进入编辑模式并等待宿主状态同步，其他视图类型不可用。</field>
        <field name="sequence">80</field>
    </record>
    <record id="command_validate_current_form" model="agui.chat.command">
        <field name="name">校验当前表单</field>
        <field name="code">odoo.validate_current_form</field>
        <field name="command_type">page</field>
        <field name="description">仅当当前宿主快照的 viewType 为 form 时，执行当前原生表单渲染器校验；其他视图类型不可用。</field>
        <field name="sequence">90</field>
    </record>
    <record id="command_save_current_form" model="agui.chat.command">
        <field name="name">保存当前表单</field>
        <field name="code">odoo.save_current_form</field>
        <field name="command_type">page</field>
        <field name="description">仅当当前宿主快照的 viewType 为 form 时，通过当前原生表单控制器保存表单；其他视图类型不可用。</field>
        <field name="sequence">100</field>
    </record>
    <record id="command_discard_current_form" model="agui.chat.command">
        <field name="name">放弃当前表单</field>
        <field name="code">odoo.discard_current_form</field>
        <field name="command_type">page</field>
        <field name="description">仅当当前宿主快照的 viewType 为 form 时，确认后放弃当前原生表单的更改；其他视图类型不可用。</field>
        <field name="sequence">110</field>
    </record>
</odoo>
