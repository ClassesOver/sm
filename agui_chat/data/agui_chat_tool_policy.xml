<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="policy_open_visible_record" model="agui.chat.tool.policy">
        <field name="name">打开当前视图中的记录</field>
        <field name="tool_name">odoo.open_record</field>
        <field name="access_level">navigation</field>
        <field name="confirmation_mode">never</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="policy_enter_current_form_edit_mode" model="agui.chat.tool.policy">
        <field name="name">进入当前表单编辑模式</field>
        <field name="tool_name">odoo.enter_edit_mode</field>
        <field name="access_level">navigation</field>
        <field name="confirmation_mode">never</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="policy_filter_employee" model="agui.chat.tool.policy">
        <field name="name">筛选当前员工视图</field>
        <field name="tool_name">odoo.apply_filter</field>
        <field name="access_level">read</field>
        <field name="model_name">hr.employee</field>
        <field name="confirmation_mode">never</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="policy_stage_current_form" model="agui.chat.tool.policy">
        <field name="name">暂存当前可见表单字段</field>
        <field name="tool_name">odoo.stage_current_form</field>
        <field name="access_level">write</field>
        <field name="confirmation_mode">never</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="policy_patch_current_form" model="agui.chat.tool.policy">
        <field name="name">修改并保存当前可见表单字段</field>
        <field name="tool_name">odoo.patch_current_form</field>
        <field name="access_level">write</field>
        <field name="confirmation_mode">risk</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="policy_save_current_form" model="agui.chat.tool.policy">
        <field name="name">保存当前表单</field>
        <field name="tool_name">odoo.save_current_form</field>
        <field name="access_level">write</field>
        <field name="confirmation_mode">always</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="policy_discard_current_form" model="agui.chat.tool.policy">
        <field name="name">放弃当前表单更改</field>
        <field name="tool_name">odoo.discard_current_form</field>
        <field name="access_level">write</field>
        <field name="confirmation_mode">always</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="policy_activate_visible_control" model="agui.chat.tool.policy">
        <field name="name">激活当前可见页面控件</field>
        <field name="tool_name">odoo.activate_view_control</field>
        <field name="access_level">write</field>
        <field name="confirmation_mode">risk</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
