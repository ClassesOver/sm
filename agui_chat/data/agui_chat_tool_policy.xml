        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="policy_get_x2many_import_status" model="agui.chat.tool.policy">
        <field name="name">查询 One2many 导入任务</field>
        <field name="tool_name">odoo.get_x2many_import_status</field>
