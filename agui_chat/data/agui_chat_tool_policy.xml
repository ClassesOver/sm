        <field name="confirmation_mode">never</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="policy_open_x2many_create" model="agui.chat.tool.policy">
        <field name="name">打开当前 One2many 新建表单</field>
        <field name="tool_name">odoo.open_x2many_create</field>
        <field name="access_level">navigation</field>
        <field name="confirmation_mode">never</field>
