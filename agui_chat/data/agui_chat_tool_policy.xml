    </record>
    <record id="policy_activate_visible_control" model="agui.chat.tool.policy">
        <field name="name">激活当前可见页面控件</field>
        <field name="tool_name">odoo.activate_view_control</field>
        <field name="access_level">write</field>
        <field name="confirmation_mode">risk</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
