        "rj.dm_hdc_gongzuoliang_view.data_date"
      ]
    },
    {
      "code": "year",
      "kind": "time",
      "description": "项目预算日历年度；INTEGER 类型不代表可聚合指标。",
      "fieldRefs": [
        "rj.dwd_project_budget_view.period_year"
      ]
